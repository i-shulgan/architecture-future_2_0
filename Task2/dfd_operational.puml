@startuml dfd_operational
title DFD уровня 1 — операционные потоки данных между доменами

skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam ArrowColor #7b7d7d
skinparam ArrowFontSize 10
skinparam rectangle<<external>> {
  BackgroundColor #d5d8dc
  BorderColor #566573
  FontStyle bold
}
skinparam usecase {
  BackgroundColor #d6eaf8
  BorderColor #2874a6
  FontStyle bold
}
skinparam database {
  BackgroundColor #fef9e7
  BorderColor #9a7d0a
}
skinparam database<<medical>> {
  BackgroundColor #f5b7b1
  BorderColor #b03a2e
}
skinparam database<<bank>> {
  BackgroundColor #fae5d3
  BorderColor #b9770e
}
hide stereotype

rectangle "Пациент / клиент" as patient <<external>>
rectangle "Оператор / врач клиники" as operator <<external>>
rectangle "Фармацевтические\nкомпании" as pharma <<external>>
rectangle "Производитель\nмедоборудования" as devices <<external>>
rectangle "Банк России" as cbr <<external>>

rectangle "Домен «Клиники» — медицинский контур" as dClinic #fdf2f2;line:b03a2e;line.dashed {
  usecase "1.1\nПриём пациента\nи исследования" as p11
  usecase "1.2\nОбезличивание\nданных" as p12
  database "D1 Медкарты, истории\nболезни, результаты\nисследований" as d1 <<medical>>
  database "D2 Медснимки" as d2 <<medical>>
  database "D3 Пациенты, услуги\nи счета" as d3
}

rectangle "Домен «ИИ-диагностика» — медицинский контур" as dAi #fdf2f2;line:b03a2e;line.dashed {
  usecase "2.1\nАнализ\nисследования" as p21
  usecase "2.2\nОбучение и выкатка\nмоделей" as p22
  database "D4 Обучающие датасеты\n(обезличенные)" as d4 <<medical>>
  database "D5 Реестр моделей" as d5
}

rectangle "Домен «Клиенты»" as dCust #f4f6f7;line:566573;line.dashed {
  usecase "4.1\nВедение профиля\nи согласий" as p41
  database "D7 Профили клиентов\nи согласия" as d7
}

rectangle "Домен «Финтех» — контур банка" as dFin #fef5e7;line:b9770e;line.dashed {
  usecase "3.1\nОформление рассрочки\nна лечение" as p31
  usecase "3.2\nПроведение\nплатежей" as p32
  usecase "3.3\nРегуляторная\nотчётность" as p33
  database "D6 Счета, кредиты,\nплатежи" as d6 <<bank>>
}

rectangle "Интеграционная платформа" as dInt #f4f6f7;line:566573;line.dashed {
  database "D9 Журнал доменных событий\n(контракты в Schema Registry)" as d9
}

rectangle "Домен «Партнёры»: поддомены «Фарма» и «Медоборудование»" as dPart #f5eef8;line:7d3c98;line.dashed {
  usecase "5.1\nПриём и преобразование\nданных партнёров (ACL)" as p51
}

rectangle "Домен\n«Головной офис»" as dCorp #f4f6f7;line:566573;line.dashed {
  usecase "6.1\nУчёт, закупки,\nперсонал" as p61
  database "D8 Учётные данные" as d8
}

' --- Приём пациента и сценарий А: ИИ анализирует медицинские данные (только внутри медицинского контура)
operator --> p11 : 1: данные приёма,\nрезультаты исследований, снимки
patient --> p11 : 2: запись на приём
p41 --> p11 : 3: единый ID клиента
p11 -[#b03a2e,bold]-> d1 : 4: осмотры, диагнозы,\nрезультаты исследований
p11 -[#b03a2e,bold]-> d2 : 5: снимки
p11 --> d3 : 6: пациенты, оказанные\nуслуги, счета
d1 -[#b03a2e,bold]-> p11 : 7: история болезни,\nрезультаты исследований
p11 --> operator : 8: история пациента,\nподсказка ИИ, расписание
p11 --> patient : 9: заключения,\nсчета на оплату
p11 -[#b03a2e,bold]-> p21 : 10 [А]: запрос анализа\nс временной ссылкой на снимок
d2 -[#b03a2e,bold]-> p21 : 11 [А]: снимок по ссылке\nиз запроса
p21 -[#b03a2e,bold]-> p11 : 12 [А]: подсказка-заключение\nдля врача
d1 -[#b03a2e,bold]-> p12 : 13 [А]: исследования\nи результаты
d2 -[#b03a2e,bold]-> p12 : 14 [А]: снимки
p12 -[#b03a2e,bold]-> d4 : 15 [А]: обезличенные датасеты\nпо контракту
d4 -[#b03a2e,bold]-> p22 : 16 [А]: датасеты
p22 -[#b03a2e,bold]-> d5 : 17 [А]: проверенная\nверсия модели
d5 -[#b03a2e,bold]-> p21 : 18 [А]: модель\nдля инференса

' --- Сценарий Б: новый финтех-сервис «рассрочка на лечение»
patient --> p41 : 19: персональные данные,\nсогласие на финуслуги
p41 <--> d7 : 20: профиль, согласия\n(запись и чтение)
p41 --> d9 : 21: событие «согласие\nизменено»
p11 -[#ca6f1e,bold]-> d9 : 22 [Б]: событие «счёт выставлен»\n(ID клиента, сумма, без диагноза)
patient -[#ca6f1e,bold]-> p31 : 23 [Б]: заявка на рассрочку
d9 -[#ca6f1e,bold]-> p31 : 24 [Б]: событие\n«счёт выставлен»
p41 -[#ca6f1e,bold]-> p31 : 25 [Б]: ID клиента,\nстатус согласия
d9 -[#ca6f1e,bold]-> p31 : 26 [Б]: событие «согласие\nизменено» (отзыв)
p31 -[#ca6f1e,bold]-> d6 : 27 [Б]: договор рассрочки,\nграфик платежей
p31 -[#ca6f1e,bold]-> patient : 28 [Б]: решение по заявке
d6 -[#ca6f1e,bold]-> p32 : 29 [Б]: график платежей
patient -[#ca6f1e,bold]-> p32 : 30 [Б]: платёж по графику\nрассрочки
p32 -[#ca6f1e,bold]-> d6 : 31 [Б]: проведённые платежи
p32 -[#ca6f1e,bold]-> patient : 32 [Б]: выписка
p32 -[#ca6f1e,bold]-> d9 : 33 [Б]: событие «счёт оплачен»\n(перечисление клинике\nпри выдаче рассрочки)
d9 -[#ca6f1e,bold]-> p11 : 34 [Б]: событие «счёт оплачен»\n→ статус счёта в D3
d9 -[#ca6f1e,bold]-> p61 : 35 [Б]: события оплат\nдля финучёта
d6 --> p33 : 36: операции банка
p33 --> cbr : 37: обязательная отчётность

' --- Сценарий В: подключение партнёров
pharma -[#7d3c98,bold]-> p51 : 38 [В]: каталоги, цены,\nпоставки
devices -[#7d3c98,bold]-> p51 : 39 [В]: телеметрия,\nсервисные события
p51 -[#7d3c98,bold]-> d9 : 40 [В]: события партнёров\nв формате контракта
d9 -[#7d3c98,bold]-> p61 : 41 [В]: поставки, состояние\nоборудования
d9 -[#7d3c98,bold]-> p11 : 42 [В]: состояние оборудования\nклиники, справочник препаратов
p61 -[#7d3c98,bold]-> d9 : 43 [В]: заказы препаратов,\nзаявки на обслуживание
d9 -[#7d3c98,bold]-> p51 : 44 [В]: заказы и заявки
p51 -[#7d3c98,bold]-> pharma : 45 [В]: заказы препаратов
p51 -[#7d3c98,bold]-> devices : 46 [В]: заявки на обслуживание
p61 --> d8 : 47: учётные данные

legend bottom right
  <b>Обозначения</b>
  Серый прямоугольник — внешняя сущность
  Эллипс — процесс (номер = домен.процесс)
  Цилиндр — хранилище данных; красный — медданные (включая обезличенные), оранжевый — банковская тайна
  <color:#b03a2e><b>━━</b></color> [А] ИИ анализирует медицинские данные (только внутри медицинского контура)
  <color:#ca6f1e><b>━━</b></color> [Б] Новый финтех-сервис «рассрочка на лечение»
  <color:#7d3c98><b>━━</b></color> [В] Подключение партнёров (фарма, медоборудование)
  <color:#7b7d7d><b>━━</b></color> Прочие операционные потоки
endlegend

@enduml
